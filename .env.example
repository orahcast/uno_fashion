# =============================================================================
# Uno Fashion Agency - Environment Variables
# =============================================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase Service Role Key (for backend server-side admin operations only, never prefix with NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Authentication
# Boutique Owner Email: ufashionagency@gmail.com
# Master Password: Unofashion123!
# Set to 'false' in production to strictly enforce Supabase Auth on all admin dashboard routes
NEXT_PUBLIC_DEMO_MODE=true

